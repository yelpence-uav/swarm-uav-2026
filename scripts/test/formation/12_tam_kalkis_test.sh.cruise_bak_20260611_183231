#!/bin/bash
# Tam misyon: kalkış + V formasyon + öteleme + heading dönüşleri
# Hungarian=true → optimal atama, yollar kesişmez
# CA influence_radius=0.1m → pratikte hiç tetiklenmez
# kinematic_fusion AÇIK → v_align çalışır
# Toplam kayıt ~160s

source /opt/ros/jazzy/setup.bash
source ~/ros2_ws/install/setup.bash

BAG=~/test_v_kalkis
rm -rf "$BAG"

# Merkez koordinatı (kalkış noktası)
LAT0=41.04418990
LON0=29.00170000
# 20m kuzey: Δlat = 20/111000 = 0.000180°
LAT_N=41.04436990
# 20m doğu: Δlon = 20/(111000·cos41°) = 20/83772 = 0.000239°
LON_E=29.00193900
# 20m güney: Δlat = -20/111000 = -0.000180°
LAT_S=41.04400990

echo "[0/8] Eski publisher temizleniyor..."
pkill -9 -f "formation_test_publisher" 2>/dev/null || true
sleep 1

# CA node'un influence_radius'unu 0.1m'e çek → dronlar birbirine
# 0.1m'den yaklaşmadıkça CA tetiklenmez, 4 m/s kaçış olmaz.
# kinematic_fusion AÇIK kalıyor → v_align (hız kohezyonu) çalışır.
echo "[0/8] CA influence_radius sıfırlanıyor (v_align aktif, CA etkisiz)..."
# CA node ismi: /collision_avoidance (namespace YOK, 3 instance aynı isimde)
# Her instance'ı agent_id parametresine göre hedef alıyoruz
for attempt in 1 2 3; do
  sleep 0.5
  ok=0
  ros2 param set /collision_avoidance influence_radius_m 0.1 --qos-durability transient_local 2>/dev/null && ok=$((ok+1)) || true
  # 3 ayrı instance — hepsine set et
  for node in $(ros2 node list 2>/dev/null | grep collision_avoidance); do
    ros2 param set "$node" influence_radius_m 0.1 2>/dev/null && ok=$((ok+1)) || true
  done
  [ "$ok" -ge 3 ] && echo "  CA param set OK (attempt $attempt)" && break
  echo "  CA param set $ok/3+ (attempt $attempt), tekrar..."
done

echo "[1/8] Bag kaydı başlıyor: $BAG"
ros2 bag record \
  /drone_1/control/setpoint/raw \
  /drone_2/control/setpoint/raw \
  /drone_3/control/setpoint/raw \
  /drone_1/control/setpoint \
  /drone_2/control/setpoint \
  /drone_3/control/setpoint \
  /swarm/internal/drone1/status \
  /swarm/internal/drone2/status \
  /swarm/internal/drone3/status \
  /swarm/public/formation/target \
  -o "$BAG" &
BAG_PID=$!
sleep 3

echo "[2/8] Kalkış başlatılıyor (hedef: 15m)..."
if ! python3 ~/ros2_ws/scripts/test/formation/sync_takeoff.py; then
  echo "[İPTAL] Kalkış başarısız — formasyon fazına geçilmiyor, bag kapatılıyor."
  kill -INT "$BAG_PID" 2>/dev/null || true
  pkill -INT -f "ros2 bag record" 2>/dev/null || true
  for i in $(seq 1 15); do [ -f "$BAG/metadata.yaml" ] && break; sleep 1; done
  exit 1
fi
echo "  Kalkış doğrulandı."
sleep 5  # Dronlar kararlılaşsın

# pub <tgt_hdg> <start_hdg> <rate_dps> <center_lat> <center_lon> <move_speed> <move_hdg>
# Hungarian=true → Macar atamayı BAŞLANGIÇ heading'inde kilitler → swap/çapraz yok.
# İleri uçuş: move_speed>0 + move_heading=heading → sürü BURNU yönünde ilerler
#   (yana kayma DEĞİL). center_lat/lon = fazın BAŞLANGIÇ noktası (jump yok).
# Dönüş: rate>0, move_speed=0 → yerinde rijit döner.
# max_speed=1.2 m/s: ileri 1.0 + formasyon düzeltme payı.
pub() {
  pkill -9 -f formation_test_publisher 2>/dev/null || true
  sleep 0.5
  ros2 run swarm_core formation_test_publisher --ros-args \
    -p agent_ids:=[1,2,3] \
    -p formation_type:=2 \
    -p spacing_m:=8.0 \
    -p heading_deg:="$1" \
    -p start_heading_deg:="$2" \
    -p heading_rate_dps:="$3" \
    -p use_hungarian:=true \
    -p center_z:=-15.0 \
    -p use_proxy:=false \
    -p center_lat:="$4" \
    -p center_lon:="$5" \
    -p move_speed_mps:="$6" \
    -p move_heading_deg:="$7" \
    -p max_speed_mps:=1.2 &
  echo "[$(date +%H:%M:%S)] hdg $2°→$1° (rate=$3°/s) @ ($4,$5) move=$6 m/s→$7°"
}

# KRİTİK: Dronlar spawn'da DOĞUYA (90°) bakarak kalkıyor. Form-up'ı 90° ile
# başlatıyoruz → yaw snap YOK → kalkıştan formasyona pürüzsüz geçiş.
# Misyon doğu-yönelimli: form-up(90°) → doğu uçuş → dönüş → güney uçuş → dönüş.
echo "[3/8] V Formasyon kuruluyor (heading=90°=spawn yönü, hover, YAW SNAP YOK)..."
pub 90.0 90.0 0.0 "$LAT0" "$LON0" 0.0 0.0
sleep 22

echo "[4/8] İLERİ UÇUŞ doğu (heading=90°, burun yönünde 1 m/s)..."
pub 90.0 90.0 0.0 "$LAT0" "$LON0" 1.0 90.0
sleep 22  # ~20m doğu

echo "[5/8] Rijit DÖNÜŞ 90°→180° (7°/s, yerinde, doğu merkezde)..."
pub 180.0 90.0 7.0 "$LAT0" "$LON_E" 0.0 0.0
sleep 20

echo "[6/8] İLERİ UÇUŞ güney (heading=180°, burun yönünde 1 m/s)..."
pub 180.0 180.0 0.0 "$LAT0" "$LON_E" 1.0 180.0
sleep 22  # ~20m güney

echo "[7/8] Rijit DÖNÜŞ 180°→270° (7°/s, yerinde)..."
pub 270.0 180.0 7.0 "$LAT_S" "$LON_E" 0.0 0.0
sleep 25

echo "[8/8] Test tamamlandı, kayıt kapatılıyor..."
pkill -9 -f "formation_test_publisher" 2>/dev/null || true
sleep 1
kill -INT "$BAG_PID" 2>/dev/null || true
pkill -INT -f "ros2 bag record" 2>/dev/null || true
for i in $(seq 1 15); do
  [ -f "$BAG/metadata.yaml" ] && break
  sleep 1
done
sleep 1

echo "=== TAMAMLANDI ==="
ls -lh "$BAG"/
[ -f "$BAG/metadata.yaml" ] && echo "[OK] bag temiz kapandı" \
  || echo "[UYARI] metadata yok — bag bozuk olabilir"
