# ExecuteFormation.action
# Long-running formation execution action.
# Goal -> requested formation
# Result -> final formation quality
# Feedback -> live formation progress/error
# Coordinate convention: local NED frame.

uint32 sequence_num

uint8 FORMATION_UNKNOWN=0
uint8 FORMATION_OKBASI=1
uint8 FORMATION_V=2
uint8 FORMATION_CIZGI=3
uint8 FORMATION_CUSTOM=99

uint8 formation_type

# Agents that must participate in this formation execution.
# Empty array = formation_control decides from currently active IN_SWARM agents.
# Explicit list is required after detach/rejoin or standby replacement flows.
uint8[] participating_agent_ids

float32 center_x
float32 center_y
float32 center_z

float32 heading_deg
float32 spacing_m

# Optional custom formation fields.
# If formation_type == FORMATION_CUSTOM, agent_ids, offset_x, offset_y, offset_z must have equal length.
uint8[] agent_ids
float32[] offset_x
float32[] offset_y
float32[] offset_z

float32 position_tolerance_m
float32 heading_tolerance_deg
float32 timeout_sec
---
bool success
string result_message

float32 final_max_error_m
float32 final_avg_error_m
float32 final_heading_error_deg
---
float32 progress_percent

float32 current_max_error_m
float32 current_avg_error_m
float32 current_heading_error_deg

string feedback_message
