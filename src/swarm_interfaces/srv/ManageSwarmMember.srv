# ManageSwarmMember.srv
# Lightweight request interface for starting a detach/rejoin flow.
# For long-running completion tracking, prefer ManageSwarmMember.action.

uint32 sequence_num

uint8 OP_UNKNOWN=0
uint8 OP_DETACH=1
uint8 OP_REJOIN=2
uint8 OP_REPLACE_WITH_STANDBY=3

uint8 operation
uint8 target_agent_id

uint8 COLOR_UNKNOWN=0
uint8 COLOR_RED=1
uint8 COLOR_BLUE=2
uint8 target_color

float32 wait_s
float32 timeout_s

string source_module
string reason
---
bool accepted
bool success
string message
