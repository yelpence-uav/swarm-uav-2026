# AssignRole.srv
# Assign or update agent role. Used by consensus / mission orchestration.
# Topic: /swarm/agent/{id}/assign_role  (her drone'da ayrı agent_fsm_node çalışır; global topic kullanılmaz)

uint8 ROLE_UNKNOWN=0
uint8 ROLE_LEADER=1
uint8 ROLE_FOLLOWER=2
uint8 ROLE_STANDBY=3
uint8 ROLE_DETACHED=4

uint8 target_agent_id
uint8 role
string reason
---
bool success
string message
