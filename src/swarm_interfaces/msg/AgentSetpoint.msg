# AgentSetpoint.msg
# Per-agent setpoint generated by formation_control / maneuver_executor / failsafe_manager.
# Consumer: swarm_control/px4_interface.
# Coordinate convention: local NED frame.
# x,y,z are metres. In NED, z positive is down.

builtin_interfaces/Time stamp

uint32 sequence_num
uint8 agent_id

# Setpoint source / command class
uint8 SOURCE_UNKNOWN=0
uint8 SOURCE_FORMATION_CONTROL=1
uint8 SOURCE_MANEUVER_EXECUTOR=2
uint8 SOURCE_POSITION_CONTROLLER=3
uint8 SOURCE_COLLISION_AVOIDANCE=4
uint8 SOURCE_FAILSAFE_MANAGER=5

# Priority order for px4_interface arbitration when multiple modules publish setpoints.
# Higher number wins: FAILSAFE > COLLISION_AVOIDANCE > MANEUVER > FORMATION.
uint8 PRIORITY_FORMATION=10
uint8 PRIORITY_MANEUVER=20
uint8 PRIORITY_POSITION=30
uint8 PRIORITY_COLLISION_AVOIDANCE=80
uint8 PRIORITY_FAILSAFE=100

uint8 source
uint8 priority

# Position setpoint in local NED frame
float32 x
float32 y
float32 z

# Optional velocity feed-forward in local NED frame
float32 vx
float32 vy
float32 vz

# Optional acceleration feed-forward in local NED frame
float32 ax
float32 ay
float32 az

# Heading/yaw command in degrees, swarm convention.
float32 heading_deg

# Optional yaw-rate command for smooth formation rotation / Mission-2 yaw manoeuvre.
# Units: degrees/second. Positive direction follows the convention in SwarmControlCommand.
float32 yaw_rate_deg_s

# Validity flags. px4_interface must only use fields whose valid flag is true.
bool position_valid
bool velocity_valid
bool acceleration_valid
bool heading_valid
bool yaw_rate_valid

# Safety/hold hints
bool hold_position
bool land_now
bool rtl_now

float32 position_tolerance_m
float32 heading_tolerance_deg

# Speed and acceleration limits for px4_interface TrajectorySetpoint computation.
# 0.0 means "use px4_interface default / no override".
# SwarmControlCommand.max_speed_mps is propagated here so px4_interface stays the single
# PX4 writer and does not need to subscribe to SwarmControlCommand directly.
float32 max_speed_mps
float32 max_acc_mps2

string source_module
