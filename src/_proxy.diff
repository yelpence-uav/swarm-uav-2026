+        target = now + self.rf_model.get_jitter()
+        last = self._last_scheduled.get(channel_key, 0.0)
+        if target <= last:
+            target = last + 1e-6
+        self._last_scheduled[channel_key] = target
+        heapq.heappush(
+            self._pending, (target, next(self._seq_counter), publisher, msg)
+        )
