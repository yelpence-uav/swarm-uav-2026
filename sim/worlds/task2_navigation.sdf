          <geometry><box><size>50 0.15 0.01</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <visual name="line_left">
          <pose>-24.925 0 0.01 0 0 0</pose>
          <geometry><box><size>0.15 30 0.01</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <visual name="line_right">
          <pose>24.925 0 0.01 0 0 0</pose>
          <geometry><box><size>0.15 30 0.01</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>

        <visual name="pen_left_front">
          <pose>-19 0 0.01 0 0 0</pose>
          <geometry><box><size>0.15 12 0.01</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <visual name="pen_left_top">
          <pose>-22 6 0.01 0 0 0</pose>
