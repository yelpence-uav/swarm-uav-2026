          <geometry><box><size>6 0.15 0.01</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_left">
      <static>true</static>
      <pose>0 15 5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>50 0.1 10</size></box></geometry></collision>
