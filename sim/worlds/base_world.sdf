<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="base_world">
    
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <physics type="ode">
      <max_step_size>0.008</max_step_size>
      <real_time_update_rate>0</real_time_update_rate>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <scene>
      <ambient>1.0 1.0 1.0 1.0</ambient>
      <background>0.5 0.8 0.95 1</background>
      <shadows>false</shadows>
      <grid>false</grid> 
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <direction>0 0 -1</direction>
    </light>

    <model name="university_football_field">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>105 68</size></plane></geometry>
        </collision>

        <visual name="field_visual">
          <geometry><plane><normal>0 0 1</normal><size>105 68</size></plane></geometry>
          <material>
            <ambient>0.1 0.4 0.1 1</ambient>
            <diffuse>0.1 0.4 0.1 1</diffuse>
          </material>
        </visual>

        <visual name="line_center"><pose>0 0 0.01 0 0 0</pose><geometry><plane><normal>0 0 1</normal><size>0.15 68</size></plane></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="line_top"><pose>0 34 0.01 0 0 0</pose><geometry><plane><normal>0 0 1</normal><size>105 0.15</size></plane></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="line_bottom"><pose>0 -34 0.01 0 0 0</pose><geometry><plane><normal>0 0 1</normal><size>105 0.15</size></plane></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="line_left"><pose>-52.5 0 0.01 0 0 0</pose><geometry><plane><normal>0 0 1</normal><size>0.15 68</size></plane></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="line_right"><pose>52.5 0 0.01 0 0 0</pose><geometry><plane><normal>0 0 1</normal><size>0.15 68</size></plane></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>

        <visual name="center_circle_white">
          <pose>0 0 0.011 0 0 0</pose>
          <geometry><cylinder><radius>9.15</radius><length>0.001</length></cylinder></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <visual name="center_circle_green">
          <pose>0 0 0.012 0 0 0</pose>
          <geometry><cylinder><radius>9.0</radius><length>0.001</length></cylinder></geometry>
          <material><ambient>0.1 0.4 0.1 1</ambient><diffuse>0.1 0.4 0.1 1</diffuse></material>
        </visual>
        <visual name="center_spot">
          <pose>0 0 0.013 0 0 0</pose>
          <geometry><cylinder><radius>0.3</radius><length>0.001</length></cylinder></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>

        <visual name="pen_left_front"><pose>-36 0 0.015 0 0 0</pose><geometry><plane><normal>0 0 1</normal><size>0.15 30</size></plane></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="pen_left_top"><pose>-44.25 15 0.015 0 0 0</pose><geometry><plane><normal>0 0 1</normal><size>16.5 0.15</size></plane></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="pen_left_bottom"><pose>-44.25 -15 0.015 0 0 0</pose><geometry><plane><normal>0 0 1</normal><size>16.5 0.15</size></plane></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>

        <visual name="pen_right_front"><pose>36 0 0.015 0 0 0</pose><geometry><plane><normal>0 0 1</normal><size>0.15 30</size></plane></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="pen_right_top"><pose>44.25 15 0.015 0 0 0</pose><geometry><plane><normal>0 0 1</normal><size>16.5 0.15</size></plane></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="pen_right_bottom"><pose>44.25 -15 0.015 0 0 0</pose><geometry><plane><normal>0 0 1</normal><size>16.5 0.15</size></plane></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
