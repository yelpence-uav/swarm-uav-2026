<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='x500_lidar_down'>
    <self_collide>false</self_collide>
      <include merge='true'>
      <uri>model://x500</uri>
    </include>

    <!-- Downward LiDAR (Moved to front-center) -->
    <link name="lidar_sensor_link">
      <pose relative_to="base_link">0.05 0 -0.05 0 1.5707 0</pose>
      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry><box><size>0.035 0.021 0.0135</size></box></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <sensor name="lidar" type="gpu_lidar">
        <update_rate>100</update_rate>
        <ray>
          <scan>
            <horizontal><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></horizontal>
            <vertical><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></vertical>
          </scan>
          <range><min>0.15</min><max>8.0</max><resolution>0.01</resolution></range>
        </ray>
        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>
    </link>

    <!-- Camera (Center-Aligned, Downward Lens) -->
    <link name="camera_link">
      <pose relative_to="base_link">0 0 -0.05 0 1.5707 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz>
        </inertia>
      </inertial>
      <visual name="body_visual">
        <geometry><box><size>0.04 0.04 0.03</size></box></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <visual name="lens_visual">
        <pose>0.02 0 0 0 1.5707 0</pose>
        <geometry><cylinder><radius>0.012</radius><length>0.02</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
      <sensor name="camera" type="camera">
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image><width>1280</width><height>720</height><format>R8G8B8</format></image>
          <clip><near>0.1</near><far>1000</far></clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>5</update_rate>
        <visualize>true</visualize>
      </sensor>
    </link>

    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_sensor_link</child>
    </joint>

    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>

    <!-- 4-Way ToF Sensors (Omnidirectional awareness) -->
    <!-- Front ToF Sensor -->
    <link name='tof_front_link'>
      <pose relative_to='base_link'>0.2 0 -0.022 0 0 0</pose>
      <inertial>
        <mass>0.002</mass>
        <inertia><ixx>0.000001</ixx><iyy>0.000001</iyy><izz>0.000001</izz></inertia>
      </inertial>
      <visual name='visual'>
        <geometry><box><size>0.02 0.01 0.01</size></box></geometry>
        <material><ambient>1 0.5 0 1</ambient><diffuse>1 0.5 0 1</diffuse></material>
      </visual>
      <sensor name='tof_front' type='gpu_ray'>
        <update_rate>10</update_rate>
        <visualize>true</visualize>
        <always_on>1</always_on>
        <ray>
          <scan><horizontal><samples>1</samples><min_angle>0</min_angle><max_angle>0</max_angle></horizontal></scan>
          <range><min>0.05</min><max>4.0</max></range>
        </ray>
      </sensor>
    </link>
    <joint name='tof_front_joint' type='fixed'><parent>base_link</parent><child>tof_front_link</child></joint>

    <!-- Back ToF Sensor -->
    <link name='tof_back_link'>
      <pose relative_to='base_link'>-0.2 0 -0.022 0 0 3.14159</pose>
      <inertial>
        <mass>0.002</mass>
        <inertia><ixx>0.000001</ixx><iyy>0.000001</iyy><izz>0.000001</izz></inertia>
      </inertial>
      <visual name='visual'>
        <geometry><box><size>0.02 0.01 0.01</size></box></geometry>
        <material><ambient>1 0.5 0 1</ambient><diffuse>1 0.5 0 1</diffuse></material>
      </visual>
      <sensor name='tof_back' type='gpu_ray'>
        <update_rate>10</update_rate>
        <visualize>true</visualize>
        <always_on>1</always_on>
        <ray>
          <scan><horizontal><samples>1</samples><min_angle>0</min_angle><max_angle>0</max_angle></horizontal></scan>
          <range><min>0.05</min><max>4.0</max></range>
        </ray>
      </sensor>
    </link>
    <joint name='tof_back_joint' type='fixed'><parent>base_link</parent><child>tof_back_link</child></joint>

    <!-- Right ToF Sensor -->
    <link name='tof_right_link'>
      <pose relative_to='base_link'>0 -0.2 -0.022 0 0 -1.5707</pose>
      <inertial>
        <mass>0.002</mass>
        <inertia><ixx>0.000001</ixx><iyy>0.000001</iyy><izz>0.000001</izz></inertia>
      </inertial>
      <visual name='visual'>
        <geometry><box><size>0.02 0.01 0.01</size></box></geometry>
        <material><ambient>1 0.5 0 1</ambient><diffuse>1 0.5 0 1</diffuse></material>
      </visual>
      <sensor name='tof_right' type='gpu_ray'>
        <update_rate>10</update_rate>
        <visualize>true</visualize>
        <always_on>1</always_on>
        <ray>
          <scan><horizontal><samples>1</samples><min_angle>0</min_angle><max_angle>0</max_angle></horizontal></scan>
          <range><min>0.05</min><max>4.0</max></range>
        </ray>
      </sensor>
    </link>
    <joint name='tof_right_joint' type='fixed'><parent>base_link</parent><child>tof_right_link</child></joint>

    <!-- Left ToF Sensor -->
    <link name='tof_left_link'>
      <pose relative_to='base_link'>0 0.2 -0.022 0 0 1.5707</pose>
      <inertial>
        <mass>0.002</mass>
        <inertia><ixx>0.000001</ixx><iyy>0.000001</iyy><izz>0.000001</izz></inertia>
      </inertial>
      <visual name='visual'>
        <geometry><box><size>0.02 0.01 0.01</size></box></geometry>
        <material><ambient>1 0.5 0 1</ambient><diffuse>1 0.5 0 1</diffuse></material>
      </visual>
      <sensor name='tof_left' type='gpu_ray'>
        <update_rate>10</update_rate>
        <visualize>true</visualize>
        <always_on>1</always_on>
        <ray>
          <scan><horizontal><samples>1</samples><min_angle>0</min_angle><max_angle>0</max_angle></horizontal></scan>
          <range><min>0.05</min><max>4.0</max></range>
        </ray>
      </sensor>
    </link>
    <joint name='tof_left_joint' type='fixed'><parent>base_link</parent><child>tof_left_link</child></joint>
  
  </model>
</sdf>
